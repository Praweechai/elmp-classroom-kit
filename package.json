{
  "name": "@elmp/classroom-kit",
  "version": "0.5.1",
  "description": "ELMP Classroom kit: tokens, components, Portal client and EN/TH messages for the Mission Hospital Learning Classroom (Open edX Verawood MFE forks).",
  "license": "AGPL-3.0",
  "repository": "github:Praweechai/elmp-classroom-kit",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.js",
    "build": "rm -rf dist && fedx-scripts babel src --out-dir dist --copy-files --no-copy-ignored --ignore \"**/*.test.jsx,**/*.test.js,**/__fixtures__/**,**/*.stories.jsx,src/testUtils.jsx,src/setupTest.js,src/stories/**\"",
    "lint": "fedx-scripts eslint --ext .js,.jsx src/",
    "test": "TZ=Asia/Bangkok fedx-scripts jest --coverage --passWithNoTests"
  },
  "peerDependencies": {
    "@edx/frontend-platform": "^8.7.0",
    "@openedx/paragon": "^23.4.5",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.4.0"
  },
  "devDependencies": {
    "@edx/browserslist-config": "^1.3.0",
    "@edx/frontend-platform": "8.7.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@formatjs/icu-messageformat-parser": "2.11.4",
    "@openedx/frontend-build": "^14.6.6",
    "@openedx/paragon": "23.19.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/react": "^8.6.19",
    "@storybook/react-webpack5": "^8.6.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "http-server": "^14.1.1",
    "jest-axe": "^9.0.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "6.8.9",
    "storybook": "^8.6.19"
  },
  "browserslist": [
    "extends @edx/browserslist-config"
  ]
}
